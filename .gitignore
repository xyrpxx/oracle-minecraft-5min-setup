# Clés SSH privées — ne JAMAIS versionner
*.key
*.pem
*.ppk

# Configuration locale générée par setup.sh (contient IP + chemin de clé)
.server.conf

# Secrets / tokens locaux (jamais versionnés)
.env
*.api-token
*-token

# Sauvegardes et binaires
*.tar.gz
*.zip
backups/

# OS / éditeurs
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Scratch de session agent (plans locaux, jamais versionnés)
.zcode/
